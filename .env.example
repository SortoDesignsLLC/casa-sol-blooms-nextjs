# Set the actual public website origin before deploying to a custom domain.
# SITE_URL=https://your-domain.example

# Direct inquiry submission through Resend (server-only).
# Without both values, the form prepares an email draft for the visitor to send.
# RESEND_API_KEY=
# INQUIRY_FROM_EMAIL=Casa Sol <hello@your-verified-domain.example>
# Configure SITE_URL above so both emails use the public logo, photos, and links.
# The owner inbox is casasolmatchacoffee@gmail.com; client replies go there too.
